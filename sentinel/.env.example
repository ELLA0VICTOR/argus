# Sentinel settings. Copy to .env for local runs (node --env-file=.env).
# On Vercel, set the same names in Project Settings → Environment Variables.

# Solana devnet RPC (a private one avoids rate limits).
RPC_URL=https://api.devnet.solana.com

# Postgres for demo state (Neon). Use the pooled connection string.
DATABASE_URL=

# Web origins allowed to call Sentinel, comma-separated.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# 1 behind a host proxy (Vercel, Render), 0 locally.
TRUST_PROXY_HOPS=0

# Keys: locally they're files in sentinel/keys/ (npm run setup:keys).
# When hosted, paste each file's JSON byte array into these instead.
# KEY_FUNDER=
# KEY_AI_GUARDIAN=
# KEY_DEMO_GUARDIAN=
# KEY_DEMO_SAFE=
