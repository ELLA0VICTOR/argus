{
  "name": "argus-sentinel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Argus Sentinel: the AI guardian service. Watches vaults, scores withdrawals, cancels with a cancel-only key.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.ts",
    "start": "node --env-file=.env src/server.ts",
    "setup:keys": "node src/setup-keys.ts",
    "typecheck": "tsc --noEmit",
    "build:vercel": "node scripts/build-vercel.mjs",
    "check:watch": "node --env-file=.env src/watch-check.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@neondatabase/serverless": "^1.2.2",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@vercel/functions": "^3.11.4",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
