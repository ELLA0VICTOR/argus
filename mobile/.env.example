# Leave unset for the in-process Sentinel mock. Set only to the announced HTTPS service.
# EXPO_PUBLIC_SENTINEL_URL=https://your-sentinel-service.example

# Sentinel v0 has health + demo, not the full contacts/auth API. Configure it separately.
# Development clients infer the Metro host on port 8787 when this is unset.
# For USB: adb reverse tcp:8787 tcp:8787, then use http://127.0.0.1:8787.
# For standalone/release builds, use an HTTPS phone-reachable endpoint.
# EXPO_PUBLIC_SENTINEL_DEMO_URL=http://127.0.0.1:8787

# Public client devnet RPC; the app verifies the devnet genesis hash before signing.
# This value is included in the app bundle. Never use a server or guardian secret here.
# EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Android FCM configuration: path to an ignored local file or an EAS file environment variable.
# GOOGLE_SERVICES_JSON=./google-services.json
