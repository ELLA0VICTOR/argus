{
  "name": "argus-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/domain/demo.test.ts src/domain/vaultMetrics.test.ts src/domain/guardianCall.test.ts src/sentinel/sentinel.test.ts src/sentinel/demo.test.ts src/program/errors.test.ts src/program/client.test.ts src/program/transactions.test.ts",
    "check:expo": "expo install --check",
    "export:android": "expo export --platform android",
    "check:program-bundle": "expo export:embed --entry-file src/program/bundle-check.ts --platform android --dev false --bundle-output .program-check/index.android.bundle --max-workers 2",
    "assets:brand": "node scripts/brand-assets.mjs",
    "smoke:sentinel": "node --experimental-strip-types scripts/smoke-sentinel.ts",
    "build:development": "npx eas-cli@latest build --platform android --profile development",
    "build:preview": "npx eas-cli@latest build --platform android --profile preview"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.2.2",
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@elevenlabs/react-native": "^1.3.0",
    "@expo-google-fonts/eb-garamond": "^0.4.3",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@livekit/react-native": "^2.12.0",
    "@livekit/react-native-expo-plugin": "^1.1.0",
    "@livekit/react-native-webrtc": "^144.1.2",
    "@noble/curves": "^2.4.0",
    "@solana-mobile/mobile-wallet-adapter-protocol": "^3.0.2",
    "@solana-mobile/mobile-wallet-adapter-protocol-web3js": "^3.0.2",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "expo": "~58.1.0",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.22",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-linear-gradient": "~58.0.4",
    "expo-notifications": "~58.1.10",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "livekit-client": "^2.25.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-quick-base64": "^3.0.2",
    "react-native-quick-crypto": "^1.1.10",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "^15.16.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.4",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
