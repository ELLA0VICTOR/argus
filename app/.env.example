# Sentinel (AI guardian service) base URL. Defaults to http://localhost:8787.
VITE_SENTINEL_URL=http://localhost:8787

# The Argus voice agent (ElevenLabs). Public agent id.
VITE_ELEVENLABS_AGENT_ID=agent_3001m8ebdd1ee1yrp9ga4kcn2436

# Solana RPC used in the browser. Leave unset to go through Sentinel's relay
# (VITE_SENTINEL_URL + /v1/rpc/devnet), which keeps the private RPC key off the browser.
# If you set your own, the URL must contain "devnet": wallets pick the network from it.
# VITE_RPC_URL=https://api.devnet.solana.com
# VITE_WS_URL=wss://api.devnet.solana.com
